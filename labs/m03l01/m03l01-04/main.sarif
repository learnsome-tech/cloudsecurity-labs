{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS"
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.subprocess-shell-true.subprocess-shell-true",
          "level": "error",
          "message": {
            "text": "subprocess call with shell=True"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/export.py"
                },
                "region": {
                  "startLine": 81
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

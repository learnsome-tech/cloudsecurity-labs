{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS"
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.subprocess-shell-true.subprocess-shell-true",
          "level": "error",
          "message": {
            "text": "subprocess call with shell=True"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/export.py"
                },
                "region": {
                  "startLine": 88
                }
              }
            }
          ]
        },
        {
          "ruleId": "python.flask.security.audit.debug-enabled.debug-enabled",
          "level": "warning",
          "message": {
            "text": "Flask app run with debug=True"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "level": "error",
          "message": {
            "text": "SQL query built with string formatting"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/db.py"
                },
                "region": {
                  "startLine": 47
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

{
 "apiVersion": "networking.k8s.io/v1",
 "kind": "NetworkPolicy",
 "metadata": {
  "name": "api-scrape",
  "namespace": "shop"
 },
 "spec": {
  "podSelector": {
   "matchLabels": {
    "app": "api"
   }
  },
  "policyTypes": [
   "Ingress"
  ],
  "ingress": [
   {
    "ports": [
     {
      "port": 8081
     }
    ],
    "from": [
     {
      "namespaceSelector": {
       "matchLabels": {
        "team": "monitoring"
       }
      },
      "podSelector": {
       "matchLabels": {
        "app": "prometheus"
       }
      }
     }
    ]
   }
  ]
 }
}

{
 "reporting-app": {
  "Version": "2012-10-17",
  "Statement": [
   {
    "Effect": "Allow",
    "Action": "s3:*",
    "Resource": "*"
   },
   {
    "Effect": "Allow",
    "Action": "dynamodb:*",
    "Resource": "arn:aws:dynamodb:eu-west-2:444455556666:table/*"
   },
   {
    "Effect": "Allow",
    "Action": [
     "sqs:*",
     "kms:Decrypt"
    ],
    "Resource": "*"
   }
  ]
 },
 "ci-deployer": {
  "Version": "2012-10-17",
  "Statement": [
   {
    "Effect": "Allow",
    "Action": [
     "lambda:*",
     "cloudformation:*"
    ],
    "Resource": "*"
   },
   {
    "Effect": "Allow",
    "Action": "iam:PassRole",
    "Resource": "arn:aws:iam::444455556666:role/*"
   }
  ]
 },
 "platform-ops": {
  "Version": "2012-10-17",
  "Statement": [
   {
    "Effect": "Allow",
    "Action": [
     "iam:*",
     "ec2:*"
    ],
    "Resource": "*"
   }
  ]
 },
 "data-analyst": {
  "Version": "2012-10-17",
  "Statement": [
   {
    "Effect": "Allow",
    "Action": [
     "athena:*",
     "s3:GetObject"
    ],
    "Resource": "*"
   }
  ]
 }
}

{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "web", "namespace": "shop"},
  "spec": {
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "seccompProfile": {"type": "RuntimeDefault"}
    },
    "containers": [
      {"name": "app", "image": "registry.example.com/shop/web:1.4.2",
       "securityContext": {
         "allowPrivilegeEscalation": false,
         "readOnlyRootFilesystem": true,
         "capabilities": {"drop": ["ALL"]}
       }}
    ]
  }
}

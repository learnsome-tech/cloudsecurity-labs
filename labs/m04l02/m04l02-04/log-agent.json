{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "log-agent", "namespace": "shop"},
  "spec": {
    "hostPID": true,
    "containers": [
      {"name": "agent", "image": "registry.example.com/ops/log-agent:2.0",
       "securityContext": {"privileged": true},
       "volumeMounts": [{"name": "varlog", "mountPath": "/var/log"}]}
    ],
    "volumes": [{"name": "varlog", "hostPath": {"path": "/var/log"}}]
  }
}

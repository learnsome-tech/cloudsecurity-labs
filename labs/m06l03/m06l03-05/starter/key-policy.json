{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "AccountAdministersKeyThroughIAM", "Effect": "Allow",
     "Principal": {"AWS": "arn:aws:iam::111122223333:root"},
     "Action": ["kms:Describe*", "kms:Get*", "kms:List*", "kms:Enable*",
                "kms:Disable*", "kms:PutKeyPolicy", "kms:ScheduleKeyDeletion"],
     "Resource": "*"},
    {"Sid": "PayrollAppUsesKeyForPayrollOnly", "Effect": "Allow",
     "Principal": {"AWS": "arn:aws:iam::111122223333:role/payroll-app"},
     "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
     "Resource": "*",
     "Condition": {"StringEquals": {
       "kms:EncryptionContext:department": "payroll"}}}
  ]
}
